#include <stdio.h>
#include <string.h>

// ============================================================
// 1. CONFIGURAÇÕES INICIAIS (Manutenibilidade)
// ============================================================
// Eu defino as constantes para o tamanho, assim, se eu quiser mudar o mapa, 
// só preciso alterar este número. (Requisito Nível Novato: 5)
#define NUM_TERRITORIOS 5 
#define TAM_NOME 30 // Espaço reservado para o nome do país
#define TAM_COR 10  // Espaço reservado para a cor do exército

// ============================================================
// 2. ESTRUTURA DE DADOS (Compromisso 1: struct)
// ============================================================
/* Eu crio a struct Territorio para agrupar as informações de cada 
   país/região em uma única entidade. Isso organiza o meu "banco de dados" 
   de forma coesa. */
typedef struct {
    char nome[TAM_NOME]; // Nome do País (ex: "Brasil")
    char cor[TAM_COR];   // Cor do Exército (ex: "Verde")
    int tropas;          // Quantidade de Tropas
} Territorio;

int main() {
    // ============================================================
    // 3. INICIALIZAÇÃO ESTÁTICA DO MAPA
    // ============================================================
    /* Declaro o meu vetor estático (o mapa do jogo) com 5 posições.
       Para agilizar o teste (e atender ao pedido de personalização), 
       eu já estou preenchendo o vetor com os dados dos 5 países sul-americanos 
       e suas cores de exército. */
    Territorio mapa[NUM_TERRITORIOS] = {
        {"Brasil",    "Verde",    12},
        {"Argentina", "Azul",      8},
        {"Colombia",  "Amarelo",   5},
        {"Chile",     "Preto",    15},
        {"Peru",      "Laranja",   7}
    };

    printf("## Cadastro Inicial de Territorios - Pronto para Teste ##\n");

    // ============================================================
    // 4. EXIBIÇÃO DO ESTADO ATUAL (Requisito: Exibir os Dados)
    // ============================================================
    /* Preciso garantir que os dados foram carregados corretamente. 
       Eu monto a tabela abaixo para dar uma boa Usabilidade ao usuário final, 
       exibindo tudo de forma clara e rápida (Desempenho). */
    printf("\n\n======================================================\n");
    printf("              MAPA - ESTADO INICIAL\n");
    printf("======================================================\n");
    
    // Este é o cabeçalho da minha tabela, com formatação alinhada.
    printf("%-5s | %-28s | %-10s | %-6s\n", "ID", "TERRITORIO", "EXERCITO", "TROPAS");
    printf("----------------------------------------------------------------\n");

    // Uso o laço 'for' para percorrer cada elemento (território) do meu vetor 'mapa'.
    for (int i = 0; i < NUM_TERRITORIOS; i++) {
        // Acesso os dados usando a notação de ponto (mapa[i].campo)
        // e uso %-Ns para manter as colunas organizadas (Manutenibilidade).
        printf("%-5d | %-28s | %-10s | %-6d\n", 
               i, 
               mapa[i].nome,    // Acesso o nome do país
               mapa[i].cor,     // Acesso a cor do exército
               mapa[i].tropas); // Acesso o número de tropas
    }
    printf("----------------------------------------------------------------\n");

    return 0; // Finalizo o meu programa
}
